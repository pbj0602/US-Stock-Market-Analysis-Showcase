# API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here   # optional fallback
FRED_API_KEY=your_fred_api_key_here
NEWS_API_KEY=your_news_api_key_here

# AI provider: 'deepseek' (default) or 'claude'. The other one is the fallback.
AI_SERVICE=deepseek
DEEPSEEK_MODEL_MAIN=deepseek-chat
DEEPSEEK_MODEL_FAST=deepseek-chat

# Telegram push — create a bot with @BotFather, send it one message,
# then use your numeric user id as the chat id.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Real account size: starting capital and current total value (cash + holdings)
ACCOUNT_INITIAL_CAPITAL=10000
TOTAL_ACCOUNT_VALUE=10000

# Optional: IBKR paper trading via IB Gateway (live account is always read-only)
ENABLE_PAPER_TRADING=false
IBKR_HOST=127.0.0.1
IBKR_LIVE_PORT=4001
IBKR_PAPER_PORT=4002
